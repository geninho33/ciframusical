# CifraTrack — deploy (copie para deploy/.env)
# Host ports (livres na VPS — não usam 3000/5432/8081/etc.)
WEB_HOST_PORT=8088
API_HOST_PORT=3200
POSTGRES_HOST_PORT=5434

# PostgreSQL
POSTGRES_USER=cifratrack
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=cifratrack

# API
API_CORS_ORIGIN=http://SEU_IP_OU_DOMINIO:8088
JWT_ACCESS_SECRET=troque-jwt-access-min-32-chars!!!!
JWT_REFRESH_SECRET=troque-jwt-refresh-min-32-chars!!!
REQUIRE_APPROVAL=true
BETA_MODE=false
BETA_INVITE_CODES=

# Seed no primeiro boot (depois mude para false)
RUN_SEED=true
SEED_ADMIN_EMAIL=admin@cifratrack.local
SEED_ADMIN_PASSWORD=Admin123!

# Front (build-time). Preferir /v1 (Nginx faz proxy → api)
VITE_API_BASE_URL=/v1
VITE_BETA_MODE=false

# Opcionais — pipeline de análise / S3 (se não tiver, upload/analyze ficam limitados)
REDIS_URL=
# Endpoint interno da API → S3; PUBLIC = o que o browser chama (não reescrever pós-assinatura)
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=cifratrack
S3_FORCE_PATH_STYLE=true
S3_CORS_ORIGINS=http://SEU_IP_OU_DOMINIO:8088
AUDIO_WORKER_URL=
API_INTERNAL_URL=http://api:3000/v1
INTERNAL_API_TOKEN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
