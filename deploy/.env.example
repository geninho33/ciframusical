# CifraTrack — deploy (copie para deploy/.env)
WEB_HOST_PORT=8088
API_HOST_PORT=3200
POSTGRES_HOST_PORT=5434
MINIO_API_HOST_PORT=9002
MINIO_CONSOLE_HOST_PORT=9003

# PostgreSQL
POSTGRES_USER=cifratrack
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=cifratrack

# API
# Use a URL pública do front (IP ou domínio + :8088)
API_CORS_ORIGIN=http://SEU_IP_OU_DOMINIO:8088
JWT_ACCESS_SECRET=troque-jwt-access-min-32-chars!!!!
JWT_REFRESH_SECRET=troque-jwt-refresh-min-32-chars!!!
REQUIRE_APPROVAL=true
BETA_MODE=false
BETA_INVITE_CODES=

# Seed / admin no boot
RUN_SEED=true
ENSURE_ADMIN=true
SEED_ADMIN_EMAIL=admin@cifratrack.local
SEED_ADMIN_PASSWORD=Admin123!

# Front (build-time). Preferir /v1 (Nginx faz proxy → api)
VITE_API_BASE_URL=/v1
VITE_BETA_MODE=false

# Redis (serviço interno do compose)
REDIS_URL=redis://redis:6379

# MinIO (serviço do compose)
# API usa S3_ENDPOINT interno; browser/player usa S3_PUBLIC_ENDPOINT no host
S3_ENDPOINT=http://minio:9000
# Só para debug/admin MinIO; o browser NÃO deve usar isso (use STORAGE_BROWSER_MODE=proxy)
S3_PUBLIC_ENDPOINT=http://SEU_IP_OU_DOMINIO:9002
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=cifratrack
S3_SECRET_ACCESS_KEY=cifratrack_secret
S3_BUCKET=cifratrack
S3_FORCE_PATH_STYLE=true
S3_CORS_ORIGINS=http://SEU_IP_OU_DOMINIO:8088
MINIO_API_CORS_ALLOW_ORIGIN=*
UPLOAD_MODE=proxy
STORAGE_BROWSER_MODE=proxy

# Worker de análise (serviço do compose — rede interna)
AUDIO_WORKER_URL=http://audio-worker:8001
API_INTERNAL_URL=http://api:3000/v1
INTERNAL_API_TOKEN=cifratrack-internal
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
