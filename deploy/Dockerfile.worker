# syntax=docker/dockerfile:1
# CifraTrack Audio Worker (FastAPI) — análise BPM/tom/acordes/letra
FROM python:3.12-slim-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    libsndfile1 \
    ffmpeg \
    curl \
    build-essential \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY services/audio-worker/ ./

RUN pip install --no-cache-dir --upgrade pip \
  && pip install --no-cache-dir . \
  && (pip install --no-cache-dir ".[analysis]" || echo "librosa opcional indisponível — fallback ativo")

ENV PYTHONUNBUFFERED=1
EXPOSE 8001

HEALTHCHECK --interval=15s --timeout=5s --retries=8 --start-period=60s \
  CMD curl -fsS http://127.0.0.1:8001/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
