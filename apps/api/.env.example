# CifraTrack — local development
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://cifratrack:cifratrack@localhost:5433/cifratrack?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=cifratrack
S3_SECRET_ACCESS_KEY=cifratrack_secret
S3_BUCKET=cifratrack
S3_FORCE_PATH_STYLE=true
S3_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API
API_PORT=3000
API_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
JWT_ACCESS_SECRET=change-me-access-dev-only
JWT_REFRESH_SECRET=change-me-refresh-dev-only
REQUIRE_APPROVAL=true

# Seed (Fase 1)
SEED_ADMIN_EMAIL=admin@cifratrack.local
SEED_ADMIN_PASSWORD=Admin123!
ENSURE_ADMIN=true

# Google OAuth (opcional — Fase 1 Should)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/oauth/google/callback

# Web
VITE_API_BASE_URL=http://localhost:3000/v1

# Audio worker / jobs
WORKER_PORT=8001
AUDIO_WORKER_URL=http://localhost:8001
API_INTERNAL_URL=http://localhost:3000/v1
INTERNAL_API_TOKEN=dev-internal-token
