# CifraTrack — local development
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://cifratrack:cifratrack@localhost:5432/cifratrack?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=cifratrack
S3_SECRET_ACCESS_KEY=cifratrack_secret
S3_BUCKET=cifratrack
S3_FORCE_PATH_STYLE=true

# API
API_PORT=3000
API_CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access-dev-only
JWT_REFRESH_SECRET=change-me-refresh-dev-only
REQUIRE_APPROVAL=true

# Web
VITE_API_BASE_URL=http://localhost:3000/v1

# Audio worker
WORKER_PORT=8001
API_INTERNAL_URL=http://localhost:3000/v1
